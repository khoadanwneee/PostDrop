PORT=3001
CORS_ORIGIN=http://localhost:3000

# From `npm run db:start` for local development, or your Supabase project settings.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=

# Used only by administrative scripts such as `npm run assets:sync-built-in`.
# Do not expose this key to the frontend or add it to the API runtime unless a
# backend-only workflow explicitly requires it.
SUPABASE_SERVICE_ROLE_KEY=

# Generate with: openssl rand -base64 32
LETTER_ENCRYPTION_KEY=
