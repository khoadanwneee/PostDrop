PORT=3001
CORS_ORIGIN=http://localhost:3000

# From `npm run db:start` for local development, or your Supabase project settings.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=

# Used by administrative scripts and the backend-only attachment sealing path.
# Never expose this key to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Generate with: openssl rand -base64 32
LETTER_ENCRYPTION_KEY=

# Durable scheduling remains in PostgreSQL. Redis stores only ready BullMQ jobs.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false

# Optional worker tuning.
WORKER_ID=
SCHEDULER_BATCH_SIZE=50
SCHEDULER_POLL_INTERVAL_MS=5000
OUTBOX_POLL_INTERVAL_MS=1000
RECONCILIATION_INTERVAL_MS=60000
SCHEDULER_LOCK_TIMEOUT_SECONDS=900
