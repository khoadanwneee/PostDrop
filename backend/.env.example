PORT=3001
CORS_ORIGIN=http://localhost:3000

# From `npm run db:start` for local development, or your Supabase project settings.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=

# Used by administrative scripts and the backend-only attachment sealing path.
# Never expose this key to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Generate with: openssl rand -base64 32
LETTER_ENCRYPTION_KEY=

# Used only to derive stable reveal capabilities. Use a different key from
# LETTER_ENCRYPTION_KEY and never expose it to the frontend.
# Generate with: openssl rand -base64 32
REVEAL_TOKEN_SECRET=
PUBLIC_APP_URL=http://localhost:3000

# Gmail uses OAuth. Never put a Google password or app password here.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
GMAIL_SENDER_NAME=PostDrop
# Only used by the one-time local OAuth helper.
GMAIL_OAUTH_PORT=53682

# Durable scheduling remains in PostgreSQL. Redis stores only ready BullMQ jobs.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false

# Optional worker tuning.
WORKER_ID=
SCHEDULER_BATCH_SIZE=50
SCHEDULER_POLL_INTERVAL_MS=5000
OUTBOX_POLL_INTERVAL_MS=1000
RECONCILIATION_INTERVAL_MS=60000
SCHEDULER_LOCK_TIMEOUT_SECONDS=900
