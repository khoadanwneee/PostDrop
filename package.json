{
  "name": "postdrop",
  "version": "1.0.0",
  "private": true,
  "description": "PostDrop — gửi một lá thư đến tương lai",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta npm:dev:api npm:dev:web",
    "dev:api": "nest start --watch",
    "dev:web": "next dev",
    "build": "npm run build:api && npm run build:web",
    "build:api": "nest build",
    "build:web": "next build",
    "start": "concurrently -n api,web -c blue,magenta npm:start:api npm:start:web",
    "start:api": "node dist/main.js",
    "start:web": "next start",
    "start:dev": "npm run dev",
    "start:prod": "npm run start",
    "lint": "eslint app next.config.ts",
    "test": "jest --runInBand",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.5",
    "@nestjs/core": "^11.1.5",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/platform-express": "^11.1.5",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.5",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.2.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {"^.+\\.(t|j)s$": "ts-jest"},
    "collectCoverageFrom": ["**/*.(t|j)s"],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
